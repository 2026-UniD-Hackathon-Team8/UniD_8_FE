# 복사해서 .env.local로 만들어 쓴다 (*.local은 git에 올라가지 않는다).
# VITE_로 시작하는 값은 브라우저에 그대로 노출되므로 비밀값은 넣지 않는다.

# 백엔드 주소. 비워 두면 같은 출처(/api)로 보내고, 로컬에서는 Vite 프록시가 받는다.
VITE_API_BASE_URL=

# 로컬 Vite 프록시가 넘길 백엔드 주소 (기본 http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# true면 홈·랭킹 등 FE C 화면이 가짜 데이터로 동작한다 (백엔드 없이 화면 확인용)
VITE_USE_MOCK=false
